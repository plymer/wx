{
  "name": "prairie-wx",
  "version": "1.1.0",
  "description": "a weather application based on open source software and data",
  "license": "MIT",
  "author": "Ryan Pimiskern / Rose Carlsen",
  "type": "module",
  "scripts": {
    "check": "pnpm run check:client && pnpm run check:server",
    "check:client": "pnpm --filter client run check",
    "check:server": "pnpm --filter server run check",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "pnpm --filter client build",
    "build:server": "pnpm --filter server build",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev": "pnpm build:server && pm2 start data-dev.config.cjs && concurrently 'pnpm --filter client dev' 'pnpm --filter server dev'",
    "preview:client": "pnpm --filter client preview",
    "preview:server": "pnpm --filter server start",
    "preview": "pnpm run build:server && pm2 restart data.config.cjs && concurrently 'pnpm run preview:client' 'pnpm run preview:server'",
    "deploy:prod": "pnpm install && pm2 stop data.config.cjs && pnpm build && pm2 start data.config.cjs && pm2 restart prod.config.cjs && pm2 save",
    "deploy:dev": "pnpm install && pm2 stop data-dev.config.cjs && pnpm build && pm2 start data-dev.config.cjs && pm2 restart dev.config.cjs && pm2 save",
    "sprites:icons": "spreet --sdf public/sprites/icons public/sprites/icons && spreet --retina --sdf public/sprites/icons public/sprites/icons@2x",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@plymer/fast-barnes-ts": "^0.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@turf/turf": "^7.3.5",
    "better-sqlite3": "12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.9.3",
    "geojson-vt": "^4.0.3",
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^5.24.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1",
    "react-router": "^7.15.1",
    "redis": "^5.12.1",
    "sonner": "^2.0.7",
    "suncalc": "^1.9.0",
    "superjson": "^2.2.6",
    "vaul": "^1.1.2",
    "vt-pbf": "^3.1.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/geojson": "^7946.0.16",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/suncalc": "^1.9.2",
    "@types/vt-pbf": "^3.1.1",
    "@vitejs/plugin-react": "^6.0.3",
    "globals": "^17.7.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@11.10.0"
}
